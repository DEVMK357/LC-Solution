class Solution {
    public List<List<Integer>> combinationSum(int[] c, int t) {
        List<List<Integer>> ans = new ArrayList<>();
        dfs(c, t, 0, new ArrayList<>(), ans);
        return ans;
    }

    void dfs(int[] c, int t, int i, List<Integer> cur, List<List<Integer>> ans) {
        if (t == 0) {
            ans.add(new ArrayList<>(cur));
            return;
        }
        if (i == c.length || t < 0) return;

        cur.add(c[i]);
        dfs(c, t - c[i], i, cur, ans);
        cur.remove(cur.size() - 1);
        dfs(c, t, i + 1, cur, ans);
    }
}
